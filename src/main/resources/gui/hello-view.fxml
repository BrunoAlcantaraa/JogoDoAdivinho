<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="641.0" prefWidth="979.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bruno.grpc.view.HelloController">
   <children>

      <!-- Área central: imagem do objeto -->
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#898989"
                 height="367.0" layoutX="232.0" layoutY="53.0"
                 stroke="BLACK" strokeType="INSIDE" width="514.0" />
      <ImageView fx:id="objetoImagem"
                 fitHeight="373.0" fitWidth="514.0"
                 layoutX="233.0" layoutY="50.0"
                 pickOnBounds="true" preserveRatio="true" />

      <!-- Labels da área central inferior -->
      <Label fx:id="objetoLabel" layoutX="232.0" layoutY="430.0"
             prefHeight="26.0" prefWidth="250.0" text="Seu número: —">
         <font><Font size="14.0" /></font>
      </Label>
      <Label fx:id="turnoJogadorLabel" layoutX="500.0" layoutY="430.0"
             prefHeight="26.0" prefWidth="246.0" text="Vez de: —">
         <font><Font size="14.0" /></font>
      </Label>

      <!-- Chat inferior -->
      <TextField fx:id="campoMensagem"
                 layoutX="232.0" layoutY="589.0"
                 onAction="#aoEnviarMSG"
                 prefHeight="28.0" prefWidth="391.0" />
      <Button fx:id="btnEnviarMsg"
              layoutX="623.0" layoutY="590.0"
              mnemonicParsing="false"
              onAction="#aoEnviarMSG"
              prefHeight="26.0" prefWidth="121.0"
              text="Enviar" />
      <ListView fx:id="listMensagens"
                layoutX="232.0" layoutY="478.0"
                prefHeight="110.0" prefWidth="514.0" />

      <!-- Painel esquerdo: lista de jogadores + ações -->
      <Label layoutX="28.0" layoutY="28.0"
             prefHeight="26.0" prefWidth="98.0" text="Jogadores">
         <font><Font size="16.0" /></font>
      </Label>
      <ListView fx:id="listJogadores"
                layoutX="28.0" layoutY="53.0"
                prefHeight="246.0" prefWidth="200.0" />

      <Button fx:id="btnEnviarDica"
              layoutX="28.0" layoutY="310.0"
              mnemonicParsing="false"
              onAction="#aoEnviarDica"
              prefHeight="35.0" prefWidth="200.0"
              text="Enviar dica" disable="true" />

      <Button fx:id="btnAdivinhar"
              layoutX="28.0" layoutY="350.0"
              mnemonicParsing="false"
              onAction="#aoAdivinhar"
              prefHeight="35.0" prefWidth="200.0"
              text="Adivinhar número" disable="true" />

      <!-- Painel direito: info do jogador + turno -->
      <Label fx:id="turnoLabel"
             layoutX="751.0" layoutY="24.0"
             prefHeight="35.0" prefWidth="200.0"
             text="Rodada —">
         <font><Font size="17.0" /></font>
      </Label>

      <Button fx:id="btnIniciarJogo"
              layoutX="751.0" layoutY="60.0"
              mnemonicParsing="false"
              onAction="#aoIniciarJogo"
              prefHeight="26.0" prefWidth="200.0"
              text="Iniciar Jogo" disable="true" />

      <Label fx:id="jogadorLabel"
             layoutX="751.0" layoutY="95.0"
             prefHeight="26.0" prefWidth="200.0"
             text="Jogador: —">
         <font><Font size="14.0" /></font>
      </Label>
      <Label fx:id="pontuacaoLabel"
             layoutX="751.0" layoutY="120.0"
             prefHeight="26.0" prefWidth="200.0"
             text="Pontuação: 0">
         <font><Font size="14.0" /></font>
      </Label>

      <Label layoutX="751.0" layoutY="155.0"
             prefHeight="26.0" prefWidth="78.0"
             text="Mensagens">
         <font><Font size="16.0" /></font>
      </Label>

   </children>
</AnchorPane>
