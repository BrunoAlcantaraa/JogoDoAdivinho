<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="660.0" prefWidth="1000.0"
            style="-fx-background-color: #f0f2f5;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bruno.grpc.view.Controller">
   <children>

      <VBox layoutX="14.0" layoutY="14.0" prefWidth="200.0" spacing="8.0">

         <Label text="Jogadores" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2d3748;">
            <font><Font size="15.0" /></font>
         </Label>

         <ListView fx:id="listJogadores" prefHeight="240.0" prefWidth="200.0"
                   style="-fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white; -fx-font-size: 12px;" />

         <Separator style="-fx-padding: 2 0 2 0;" />

         <Button fx:id="btnIniciarJogo"
                 mnemonicParsing="false"
                 onAction="#aoIniciarJogo"
                 prefHeight="34.0" prefWidth="200.0"
                 text="&#9654;  Iniciar Jogo"
                 disable="true"
                 style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand;" />

         <Button fx:id="btnEnviarDica"
                 mnemonicParsing="false"
                 onAction="#aoEnviarDica"
                 prefHeight="34.0" prefWidth="200.0"
                 text="Enviar Dica"
                 disable="true"
                 style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand;" />

         <Button fx:id="btnAdivinhar"
                 mnemonicParsing="false"
                 onAction="#aoAdivinhar"
                 prefHeight="34.0" prefWidth="200.0"
                 text="Adivinhar"
                 disable="true"
                 style="-fx-background-color: #ed8936; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand;" />

      </VBox>

      <StackPane fx:id="painelCentral"
                 layoutX="228.0" layoutY="14.0"
                 prefHeight="370.0" prefWidth="544.0"
                 style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #cbd5e0; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, #00000022, 8, 0, 0, 2);">

         <ImageView fx:id="objetoImagem"
                    fitHeight="340.0" fitWidth="520.0"
                    pickOnBounds="true" preserveRatio="true"
                    visible="false" />

         <VBox fx:id="painelDica" alignment="CENTER" spacing="16.0"
               style="-fx-padding: 30;" visible="false">
            <Label text="Dica da rodada:" style="-fx-font-size: 14px; -fx-text-fill: #718096;" />
            <Label fx:id="dicaTextoLabel"
                   text="&#8212;"
                   wrapText="true"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2d3748; -fx-text-alignment: center;" />
            <Label fx:id="dicaAutorLabel"
                   text="por &#8212;"
                   style="-fx-font-size: 14px; -fx-text-fill: #a0aec0; -fx-font-style: italic;" />
         </VBox>

         <VBox fx:id="painelSuaVez" alignment="CENTER" spacing="10.0"
               style="-fx-padding: 20;" visible="false">
            <Label text="Seu objeto secreto:" style="-fx-font-size: 14px; -fx-text-fill: #718096;" />
            <ImageView fx:id="objetoImagemSuaVez"
                       fitHeight="220.0" fitWidth="400.0"
                       pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="nomeObjetoSuaVezLabel"
                   text="&#8212;"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" />
            <Label text="Envie uma dica usando o botao a esquerda."
                   style="-fx-font-size: 12px; -fx-text-fill: #a0aec0;" />
         </VBox>

         <VBox fx:id="painelEspera" alignment="CENTER" spacing="10.0" visible="true">
            <Label text="&#9203;" style="-fx-font-size: 48px;" />
            <Label fx:id="esperaLabel"
                   text="Aguardando o jogo iniciar..."
                   style="-fx-font-size: 16px; -fx-text-fill: #a0aec0;" />
         </VBox>

      </StackPane>

      <HBox layoutX="228.0" layoutY="393.0" prefWidth="544.0" prefHeight="34.0"
            alignment="CENTER_LEFT" spacing="20.0"
            style="-fx-background-color: white; -fx-padding: 4 14 4 14; -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-background-radius: 6;">

         <Label fx:id="objetoLabel"
                text="Seu objeto: &#8212;"
                style="-fx-font-size: 13px; -fx-text-fill: #4a5568;">
            <font><Font size="13.0" /></font>
         </Label>

         <Label text="|" style="-fx-text-fill: #cbd5e0;" />

         <Label fx:id="turnoJogadorLabel"
                text="Vez de: &#8212;"
                style="-fx-font-size: 13px; -fx-text-fill: #4a5568;">
            <font><Font size="13.0" /></font>
         </Label>

      </HBox>

      <!-- Chat -->
      <Label text="Chat" layoutX="228.0" layoutY="440.0"
             style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a5568;" />

      <ListView fx:id="listMensagens"
                layoutX="228.0" layoutY="460.0"
                prefHeight="140.0" prefWidth="544.0"
                style="-fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white;" />

      <HBox layoutX="228.0" layoutY="606.0" prefWidth="544.0" spacing="8.0">
         <TextField fx:id="campoMensagem"
                    onAction="#aoEnviarMSG"
                    prefHeight="32.0" prefWidth="430.0"
                    promptText="Digite uma mensagem..."
                    style="-fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 4 8 4 8;" />
         <Button fx:id="btnEnviarMsg"
                 mnemonicParsing="false"
                 onAction="#aoEnviarMSG"
                 prefHeight="32.0" prefWidth="106.0"
                 text="Enviar"
                 style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" />
      </HBox>

      <VBox layoutX="786.0" layoutY="14.0" prefWidth="200.0" spacing="8.0">

         <Label fx:id="turnoLabel"
                text="Rodada &#8212;"
                style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;">
            <font><Font size="18.0" /></font>
         </Label>

         <Label fx:id="jogadorLabel"
                text="Jogador: &#8212;"
                style="-fx-font-size: 13px; -fx-text-fill: #4a5568;">
            <font><Font size="13.0" /></font>
         </Label>

         <Label fx:id="pontuacaoLabel"
                text="Pontuacao: 0"
                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2d3748;">
            <font><Font size="13.0" /></font>
         </Label>

         <Separator style="-fx-padding: 4 0 4 0;" />

         <Label text="Notificacoes"
                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a5568;" />

         <ListView fx:id="listNotificacoes"
                   prefHeight="420.0" prefWidth="200.0"
                   style="-fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white; -fx-font-size: 11px;" />

      </VBox>

   </children>
</AnchorPane>
